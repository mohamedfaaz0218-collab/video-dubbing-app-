# Edge TTS synthesis and alignment
# ------------------------------------------------------------------------------

def safe_get_voice_name(target_language: str, gender: str) -> str:
    gender = (gender or "female").lower()
    voices = VOICE_MAP.get(target_language, VOICE_MAP["English"])
    return voices.get(gender, voices["female"])


def synthesize_segment_audio(text: str, voice_name: str, output_wav: str) -> None:
    ensure_clean_dir(os.path.dirname(output_wav))
    communicate = Communicate(text=text, voice=voice_name)
    # edge-tts saves a .mp3 by default when using save()
    # We convert to WAV after.
    temp_mp3 = output_wav.replace(".wav", ".mp3")
    # Save the temp mp3
    loop = communicate.get()
    # communicate.get() is not a coroutine; for edge-tts it is an async generator.
    # We wrap around asyncio to be compatible with typical usage.
    import asyncio

    async def _save():
        async for chunk in communicate:
            if chunk["type"] == "audio":
                with open(temp_mp3, "wb") as f:
                    f.write(chunk["data"])
        return

    try:
        asyncio.run(_save())
    except RuntimeError:
        # Some environments already have an event loop, but this is inside a sync function.
        asyncio.run(_save())
    except Exception:
        raise

    if not os.path.exists(temp_mp3):
        raise DubbingError(f"Failed to synthesize TTS for voice {voice_name}")

    run_command([
        "ffmpeg",
        "-y",
        "-i", temp_mp3,
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        output_wav,
    ])
    safe_delete(temp_mp3)


def calculate_atempo_value(target_duration_s: float, source_duration_s: float) -> float:
    if source_duration_s <= 0 or target_duration_s <= 0:
        return 1.0
    ratio = target_duration_s / source_duration_s
    # FFmpeg atempo supports 0.5 <= speed <= 2.0 per filter
    # If ratio exceeds this range, chain multiple atempo filters.
    return float(max(0.5, min(2.0, ratio)))


def build_atempo_filter(speed_ratio: float) -> str:
    """
    Build a chained atempo filter to support stretch values outside 0.5..2.0.
    """
    filters = []
    current = float(speed_ratio)

    while current > 2.0:
        filters.append("atempo=2.0")
        current /= 2.0
    while current < 0.5:
        filters.append("atempo=0.5")
        current *= 2.0

    filters.append(f"atempo={current:.6f}")
    return ",".join(filters)


def stretch_audio_to_fit(source_wav: str, target_duration_s: float, output_wav: str) -> None:
    """
    Resizes synthesized clip to fit original timing window without changing pitch.
    Uses FFmpeg atempo, which preserves pitch.
    """
    if not os.path.exists(source_wav):
        raise DubbingError(f"Missing synthesized audio: {source_wav}")

    src_duration = get_audio_duration_seconds(source_wav)
    if src_duration <= 0:
        raise DubbingError(f"Could not determine duration of source audio: {source_wav}")

    ratio = target_duration_s / src_duration
    if ratio <= 0:
        ratio = 1.0

    # Build repeated atempo chain if needed.
    filter_chain = build_atempo_filter(ratio)

    run_command([
        "ffmpeg",
        "-y",
        "-i", source_wav,
        "-af", filter_chain,
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        output_wav
    ])


# ------------------------------------------------------------------------------
# Dialogue track assembly
# ------------------------------------------------------------------------------

def build_dialogue_track(segments: List[TranscriptSegment], work_dir: str) -> str:
    """
    Positions each aligned synthesized clip onto a silent audio track.
    """
    if not segments:
        raise DubbingError("No speech segments available to build dialogue track.")

    total_duration_ms = int(max(seg.end_time for seg in segments) * 1000) + 250
    dialogue_track = AudioSegment.silent(duration=total_duration_ms, frame_rate=16000)

    for seg in sorted(segments, key=lambda s: s.start_time):
        if not seg.source_audio_path or not os.path.exists(seg.source_audio_path):
            continue
        clip = AudioSegment.from_wav(seg.source_audio_path)
        start_ms = int(seg.start_time * 1000)
        end_ms = int(seg.end_time * 1000)
        clip = clip[: max(1, end_ms - start_ms)]
        dialogue_track = dialogue_track.overlay(clip, position=start_ms)

    output_path = os.path.join(work_dir, "dialogue_track.wav")
    dialogue_track.export(output_path, format="wav")
    return output_path


# ------------------------------------------------------------------------------
# Mixing and muxing
# ------------------------------------------------------------------------------

def mix_background_and_dialogue(background_wav: str, dialogue_wav: str, output_wav: str) -> None:
    bg = AudioSegment.from_wav(background_wav)
    dg = AudioSegment.from_wav(dialogue_wav)

    max_duration_ms = max(len(bg), len(dg))
    bg = bg[:max_duration_ms]
    dg = dg[:max_duration_ms]

    mixed = bg.overlay(dg)
    mixed.export(output_wav, format="wav")


def mux_audio_to_video(video_path: str, mixed_audio_path: str, output_video_path: str) -> None:
    ensure_clean_dir(os.path.dirname(output_video_path))
    run_command([
        "ffmpeg",
        "-y",
        "-i", video_path,
        "-i", mixed_audio_path,
        "-map", "0:v:0",
        "-map", "1:a:0",
        "-c:v", "copy",
        "-c:a", "aac",
        "-shortest",
        output_video_path,
    ])


