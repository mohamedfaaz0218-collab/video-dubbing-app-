# ------------------------------------------------------------------------------
# Data structures
# ------------------------------------------------------------------------------

class DubbingError(RuntimeError):
    pass


class TranscriptSegment:
    def __init__(
        self,
        start_time: float,
        end_time: float,
        speaker_id: str,
        original_text: str,
        translated_text: str = "",
        gender: str = "",
        voice_name: str = "",
        source_audio_path: str = "",
    ):
        self.start_time = float(start_time)
        self.end_time = float(end_time)
        self.speaker_id = speaker_id
        self.original_text = original_text.strip()
        self.translated_text = translated_text.strip()
        self.gender = gender
        self.voice_name = voice_name
        self.source_audio_path = source_audio_path

    @property
    def duration(self) -> float:
        return max(self.end_time - self.start_time, 0.1)

    def to_dict(self):
        return {
            "start_time": self.start_time,
            "end_time": self.end_time,
            "speaker_id": self.speaker_id,
            "original_text": self.original_text,
            "translated_text": self.translated_text,
            "gender": self.gender,
            "voice_name": self.voice_name,
            "source_audio_path": self.source_audio_path,
        }


# ------------------------------------------------------------------------------
# Utility functions
# ------------------------------------------------------------------------------

def run_command(command: List[str], cwd: Optional[str] = None) -> None:
    result = subprocess.run(command, cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        stderr = result.stderr.strip() if result.stderr else ""
        stdout = result.stdout.strip() if result.stdout else ""
        raise DubbingError(
            f"Command failed: {' '.join(command)}\nSTDOUT: {stdout}\nSTDERR: {stderr}"
        )


def ensure_clean_dir(directory: str) -> None:
    Path(directory).mkdir(parents=True, exist_ok=True)


def get_audio_duration_seconds(path: str) -> float:
    try:
        info = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", path],
            capture_output=True,
            text=True,
            check=True,
        )
        return float(info.stdout.strip()) if info.stdout.strip() else 0.0
    except Exception:
        return 0.0


def safe_delete(path: str) -> None:
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


# ------------------------------------------------------------------------------
# Demucs stem separation
# ------------------------------------------------------------------------------

def extract_audio_from_video(video_path: str, output_audio_path: str) -> None:
    ensure_clean_dir(os.path.dirname(output_audio_path))
    run_command([
        "ffmpeg",
        "-y",
        "-i", video_path,
        "-vn",
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        output_audio_path,
    ])


def separate_audio_stems(audio_path: str, output_dir: str) -> Tuple[str, str]:
    """
    Uses Demucs to separate vocals from the background.
    Returns:
        vocals_path, background_path
    """
    ensure_clean_dir(output_dir)

    # Try CLI demucs with htdemucs. It usually creates:
    # separated/htdemucs/<file_basename>/vocals.wav
    # plus drums.wav, bass.wav, other.wav...
    try:
        run_command([
            "demucs",
            "--two-stems", "vocals",
            "-n", "htdemucs",
            "--out", output_dir,
            audio_path,
        ])
    except Exception as exc:
        raise DubbingError(f"Demucs separation failed: {exc}")

    # Find the generated stem folder
    candidates = []
    for root, dirs, files in os.walk(output_dir):
        if root.endswith("htdemucs") or "htdemucs" in root:
            candidates.append(root)
    # The actual path often looks like output_dir/htdemucs/<audio_basename>/
    stem_root = None
    for candidate in sorted(candidates):
        if os.path.isdir(candidate):
            stem_root = candidate
            break

    if stem_root is None:
        # Some demucs versions store the stems in a child directory under output_dir.
        generated_dirs = [os.path.join(output_dir, d) for d in os.listdir(output_dir) if os.path.isdir(os.path.join(output_dir, d))]
        if generated_dirs:
            stem_root = generated_dirs[0]

    if stem_root is None:
        raise DubbingError("Demucs did not create any output folders.")

    file_pattern = os.path.basename(audio_path).rsplit(".", 1)[0]

    # Find the specific output folder for this source file
    actual_stem_dir = None
    for root, dirs, files in os.walk(stem_root):
        if file_pattern in root:
            actual_stem_dir = root
            break
    if actual_stem_dir is None and os.path.isdir(os.path.join(stem_root, file_pattern)):
        actual_stem_dir = os.path.join(stem_root, file_pattern)

    if actual_stem_dir is None:
        # Fallback: find any directory with .wav files
        wav_dirs = []
        for root, dirs, files in os.walk(stem_root):
            if any(f.lower().endswith(".wav") for f in files):
                wav_dirs.append(root)
        if wav_dirs:
            actual_stem_dir = wav_dirs[0]

    if actual_stem_dir is None:
        raise DubbingError("Could not locate Demucs output directory.")

    vocals_path = os.path.join(actual_stem_dir, "vocals.wav")
    if not os.path.exists(vocals_path):
        for file_name in os.listdir(actual_stem_dir):
            if "vocals" in file_name.lower() and file_name.lower().endswith(".wav"):
                vocals_path = os.path.join(actual_stem_dir, file_name)
                break

    if not os.path.exists(vocals_path):
        raise DubbingError("Demucs output did not include vocals.wav.")

    background_path = os.path.join(actual_stem_dir, "background.wav")
    background_wavs = []
    for file_name in os.listdir(actual_stem_dir):
        full_path = os.path.join(actual_stem_dir, file_name)
        if file_name.lower().endswith(".wav") and "vocals" not in file_name.lower():
            background_wavs.append(full_path)

    if not background_wavs:
        # Fallback: create a copy of the original audio as background if no stem files are found.
        # In a real production system, this would be replaced by more robust stem separation.
        background_path = os.path.join(actual_stem_dir, "background.wav")
        shutil.copy2(audio_path, background_path)
    else:
        mixed_background = None
        for stem_path in background_wavs:
            seg = AudioSegment.from_wav(stem_path)
            if mixed_background is None:
                mixed_background = seg
            else:
                mixed_background = mixed_background.overlay(seg)

        if mixed_background is None:
            raise DubbingError("Background stem mix is empty.")

        mixed_background.export(background_path, format="wav")

    return vocals_path, background_path


# ------------------------------------------------------------------------------
# Speaker diarization and gender detection
# ------------------------------------------------------------------------------

def estimate_pitch_frequency(audio_data: np.ndarray, sr: int) -> float:
    try:
        # A practical F0 estimator for speech.
        f0 = librosa.yin(
            audio_data.astype(np.float32),
            fmin=50,
            fmax=400,
            sr=sr
        )
        f0 = f0[np.isfinite(f0)]
        if len(f0) == 0:
            return 0.0
        return float(np.median(f0))
    except Exception:
        return 0.0


def detect_gender_from_audio(audio_path: str) -> str:
    try:
        y, sr = librosa.load(audio_path, sr=None, mono=True)
        if len(y) == 0:
            return "female"
        pitch = estimate_pitch_frequency(y, sr)
        return "male" if pitch < 165 else "female"
    except Exception:
        return "female"


def crop_segment_audio(audio_path: str, start_time: float, end_time: float, out_path: str) -> None:
    ensure_clean_dir(os.path.dirname(out_path))
    run_command([
        "ffmpeg",
        "-y",
        "-ss", str(start_time),
        "-to", str(end_time),
        "-i", audio_path,
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        out_path,
    ])


def assign_speaker_ids_from_segments(vocal_segments: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Very lightweight diarization approach:
    - estimate pitch for each segment
    - cluster by pitch consistency and energy
    - assign speaker ids deterministically in order
    """
    if not vocal_segments:
        return []

    assigned = []
    current_speaker = None
    current_pitch = None
    for idx, seg in enumerate(vocal_segments):
        audio_path = seg.get("audio_path")
        if not audio_path or not os.path.exists(audio_path):
            seg["speaker_id"] = f"speaker_{idx + 1}"
            assigned.append(seg)
            continue

        y, sr = librosa.load(audio_path, sr=None, mono=True)
        pitch = estimate_pitch_frequency(y, sr)
        energy = float(np.mean(np.abs(y))) if len(y) else 0.0

        if current_speaker is None:
            current_speaker = "speaker_1"
            current_pitch = pitch
        else:
            pitch_delta = abs(pitch - current_pitch) if pitch and current_pitch else 9999
            energy_delta = abs(energy - (seg.get("energy", 0.0)))
            if pitch_delta < 18 and energy_delta < 0.4:
                # Same speaker
                pass
            else:
                # New speaker start
                current_speaker = f"speaker_{len({item['speaker_id'] for item in assigned}) + 1}"
                current_pitch = pitch

        seg["speaker_id"] = current_speaker
        seg["energy"] = energy
        assigned.append(seg)

    return assigned


# ------------------------------------------------------------------------------
# Transcription
