def transcribe_vocal_audio(vocals_path: str, language: str = "en") -> List[Dict[str, Any]]:
    """
    Returns list of segments with:
    start, end, text
    """
    model = WhisperModel("base", device="cpu", compute_type="float32")
    segments, _ = model.transcribe(vocals_path, language=language, word_timestamps=False, vad_filter=True)

    result = []
    for segment in segments:
        if not segment.text or not segment.text.strip():
            continue
        result.append({
            "start": float(segment.start),
            "end": float(segment.end),
            "text": segment.text.strip(),
        })
    return result


def create_segment_audio_chunks(vocals_path: str, segments: List[Dict[str, Any]], temp_dir: str) -> List[Dict[str, Any]]:
    chunked = []
    for idx, seg in enumerate(segments):
        chunk_path = os.path.join(temp_dir, f"segment_{idx:03d}.wav")
        crop_segment_audio(vocals_path, float(seg["start"]), float(seg["end"]), chunk_path)
        seg["audio_path"] = chunk_path
        chunked.append(seg)
    return chunked


# ------------------------------------------------------------------------------
# Translation
# ------------------------------------------------------------------------------

def translate_text_to_language(text: str, target_language: str) -> str:
    if not text or not text.strip():
        return ""

    target_lang_code = LANGUAGE_CODE_MAP.get(target_language, "en")
    try:
        translated = GoogleTranslator(source="auto", target=target_lang_code).translate(text)
        return translated.strip() if translated else text.strip()
    except Exception:
        # Fallback: return the original text if translation fails.
        return text.strip()


