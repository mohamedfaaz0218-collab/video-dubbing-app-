# ------------------------------------------------------------------------------
# Main orchestration
# ------------------------------------------------------------------------------

def process_video_for_dubbing(
    video_path: str,
    target_language: str,
    work_dir: str,
    progress_callback=None,
) -> str:
    if not os.path.exists(video_path):
        raise FileNotFoundError(f"Video file not found: {video_path}")

    if progress_callback:
        progress_callback(0.05, "Validating inputs...")

    video_name = Path(video_path).stem
    base_dir = Path(work_dir)
    output_dir = str(base_dir / "dubbed_output")
    ensure_clean_dir(output_dir)

    audio_dir = str(base_dir / "audio")
    ensure_clean_dir(audio_dir)

    temp_dir = str(base_dir / "tmp")
    ensure_clean_dir(temp_dir)

    # 1. Extract audio
    original_audio = os.path.join(audio_dir, f"{video_name}_original.wav")
    extract_audio_from_video(video_path, original_audio)
    if progress_callback:
        progress_callback(0.12, "Extracted audio from video.")

    # 2. Demucs separation
    demucs_dir = os.path.join(audio_dir, "demucs")
    vocals_path, background_path = separate_audio_stems(original_audio, demucs_dir)
    if progress_callback:
        progress_callback(0.22, "Separated vocals and background audio.")

    # 3. Transcribe vocals
    language_code = LANGUAGE_CODE_MAP.get(target_language, "en")
    segments = transcribe_vocal_audio(vocals_path, language=language_code)

    if not segments:
        raise DubbingError("No speech segments detected in the vocal track.")

    segment_audios = create_segment_audio_chunks(vocals_path, segments, temp_dir)
    segment_audios = assign_speaker_ids_from_segments(segment_audios)

    if progress_callback:
        progress_callback(0.35, "Transcription complete; assigning speaker IDs.")

    # 4. Detect gender and translate
    translated_segments: List[TranscriptSegment] = []
    for idx, seg in enumerate(segment_audios):
        # Create a temporary chunk for gender detection
        gender_audio_path = os.path.join(temp_dir, f"gender_{idx:03d}.wav")
        crop_segment_audio(vocals_path, float(seg["start"]), float(seg["end"]), gender_audio_path)
        gender = detect_gender_from_audio(gender_audio_path)

        translated_text = translate_text_to_language(seg["text"], target_language)
        voice_name = safe_get_voice_name(target_language, gender)

        translated_segments.append(
            TranscriptSegment(
                start_time=float(seg["start"]),
                end_time=float(seg["end"]),
                speaker_id=seg["speaker_id"],
                original_text=seg["text"],
                translated_text=translated_text,
                gender=gender,
                voice_name=voice_name,
            )
        )

    if progress_callback:
        progress_callback(0.48, "Gender detection and translation complete.")

    # 5. Synthesize translated audio
    for idx, seg in enumerate(translated_segments):
        synthesized_wav = os.path.join(temp_dir, f"synth_{idx:03d}.wav")
        synthesize_segment_audio(seg.translated_text, seg.voice_name, synthesized_wav)

        target_duration = seg.duration
        aligned_wav = os.path.join(temp_dir, f"aligned_{idx:03d}.wav")
        stretch_audio_to_fit(synthesized_wav, target_duration, aligned_wav)

        seg.source_audio_path = aligned_wav

    if progress_callback:
        progress_callback(0.68, "Synthesized and time-aligned translated dialogue.")

    # 6. Build dialogue track
    dialogue_track_path = build_dialogue_track(translated_segments, temp_dir)
    if progress_callback:
        progress_callback(0.75, "Built dialogue track.")

    # 7. Mix background + dialogue
    mixed_audio_path = os.path.join(output_dir, f"{video_name}_mixed.wav")
    mix_background_and_dialogue(background_path, dialogue_track_path, mixed_audio_path)
    if progress_callback:
        progress_callback(0.82, "Mixed background and synthesized dialogue.")

    # 8. Mux audio back to original video
    final_output = os.path.join(output_dir, f"{video_name}_dubbed.mp4")
    mux_audio_to_video(video_path, mixed_audio_path, final_output)
    if progress_callback:
        progress_callback(0.90, "Muxed audio back into the original video.")

    # 9. Lip-sync placeholder
    # This hook can be replaced with Wav2Lip or Sync.so integration later.
    lip_sync_video = lip_sync_hook_placeholder(final_output, mixed_audio_path, output_dir)
    if lip_sync_video != final_output and os.path.exists(lip_sync_video):
        final_output = lip_sync_video

    if progress_callback:
        progress_callback(1.0, "Dubbing pipeline completed successfully.")

    return final_output
